# Copy to `.env` and fill in real values for local dev.
# Vite only exposes vars prefixed with VITE_ to client code.

# Backend API base URL (the Express server in ./server runs on :4000 by default).
# Leave blank for offline / design-only mode (uses a stub user, no auth gate).
VITE_API_URL=http://localhost:4000

# Google OAuth Web Client ID — used by the Google Identity Services button on
# the login screen. Get it from https://console.cloud.google.com → Credentials
# → Create credentials → OAuth client ID → "Web application" → add
# http://localhost:5173 to "Authorized JavaScript origins".
VITE_GOOGLE_CLIENT_ID=1019661152767-ocqokur7hvd7kt9fn86gidcsqqd64nv7.apps.googleusercontent.com

# Whether to call the AI fill endpoint. When unset, aiService returns a stubbed sample resume.
VITE_AI_ENABLED=false
