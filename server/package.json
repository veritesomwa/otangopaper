{
  "name": "otango-server",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "Otango backend — Express + Google OAuth + email/password auth, MongoDB-backed.",
  "main": "dist/server.js",
  "scripts": {
    "dev":        "node --watch src/index.js",
