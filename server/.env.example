# Copy to `.env` and fill in real values for local dev.

# Where the API listens
PORT=4000

# Frontend origin (CORS allow-list, comma-separated for multiple)
ALLOWED_ORIGIN=http://localhost:5173

# ── Google OAuth ────────────────────────────────────────────────────────────
# Get this from https://console.cloud.google.com → Credentials → "OAuth 2.0
# Client ID" of type "Web application". Add http://localhost:5173 to its
# Authorized JavaScript origins.
GOOGLE_CLIENT_ID=

# Optional — only needed for server-side authorization-code flows. Our
# default flow (Google Identity Services in the browser) only needs the
# Client ID. Stored here for completeness.
GOOGLE_CLIENT_SECRET=

# ── JWT ─────────────────────────────────────────────────────────────────────
# Random secret used to sign our own session tokens. Generate with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=

# Optional — token lifetime, default 30d
JWT_EXPIRES_IN=30d

# ── MongoDB ─────────────────────────────────────────────────────────────────
# Connection string (Atlas, local, etc.). Mongoose will create the database
# the first time it writes if it doesn't exist yet.
MONGO_URI=

# ── Authorization ───────────────────────────────────────────────────────────
# Comma-separated list of email addresses that are auto-promoted to admin
# the first time they sign in (or any time they sign in afterwards).
ADMIN_EMAILS=
